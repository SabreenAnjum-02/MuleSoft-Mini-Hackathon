<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:validation="http://www.mulesoft.org/schema/mule/validation" xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
http://www.mulesoft.org/schema/mule/validation http://www.mulesoft.org/schema/mule/validation/current/mule-validation.xsd">

	<http:listener-config name="HTTP_Listener_config" doc:name="HTTP Listener config">
		<http:listener-connection host="0.0.0.0" port="8081" />
	</http:listener-config>
	
	<http:request-config name="HTTP_Request_configuration" doc:name="HTTP Request configuration" >
		<http:request-connection host="localhost" port="8081" />
	</http:request-config>
	
	<configuration doc:name="Configuration" defaultErrorHandler-ref="global-error-handler" />

	<error-handler name="global-error-handler">
		<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" type="APP:INVALID_INPUT, APP:INSUFFICIENT_STOCK">
			<ee:transform doc:name="Transform Message">
				<ee:message>
					<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	"success": false,
	"errorType": error.errorType.identifier,
	"message": error.description
}]]></ee:set-payload>
				</ee:message>
				<ee:variables >
					<ee:set-variable variableName="httpStatus" ><![CDATA[400]]></ee:set-variable>
				</ee:variables>
			</ee:transform>
		</on-error-propagate>
		<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" type="APP:PRODUCT_NOT_FOUND">
			<ee:transform doc:name="Transform Message">
				<ee:message>
					<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	"success": false,
	"errorType": "PRODUCT_NOT_FOUND",
	"message": "The requested luxury product could not be found in our catalog."
}]]></ee:set-payload>
				</ee:message>
				<ee:variables >
					<ee:set-variable variableName="httpStatus" ><![CDATA[404]]></ee:set-variable>
				</ee:variables>
			</ee:transform>
		</on-error-propagate>
		<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" type="ANY">
			<ee:transform doc:name="Transform Message">
				<ee:message>
					<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	"success": false,
	"errorType": "INTERNAL_SERVER_ERROR",
	"message": error.description default "An unexpected error occurred."
}]]></ee:set-payload>
				</ee:message>
				<ee:variables>
					<ee:set-variable variableName="httpStatus"><![CDATA[500]]></ee:set-variable>
				</ee:variables>
			</ee:transform>
		</on-error-propagate>
		<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="855959d0-06c8-47e9-85b7-397b368fd327" type="HTTP:TIMEOUT, HTTP:CONNECTIVITY, HTTP:BAD_GATEWAY, HTTP:SERVICE_UNAVAILABLE">
			<ee:transform doc:name="Transform Message" doc:id="c7da5e77-aa09-4e38-a5e5-044f1aff9ecb" >
				<ee:message >
					<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  "success": false,
  "errorType": "UPSTREAM_API_FAILURE",
  "message": "An external service is currently unavailable. Please try again later.",
  "details": error.description
}]]></ee:set-payload>
				</ee:message>
				<ee:variables >
					<ee:set-variable variableName="httpStatus" ><![CDATA[503]]></ee:set-variable>
				</ee:variables>
			</ee:transform>
		</on-error-propagate>

	
</error-handler>

	<flow name="order-processing-flow" >
		<http:listener doc:name="Listener" config-ref="HTTP_Listener_config" path="/api/orders" allowedMethods="POST">
			<http:response statusCode="#[vars.httpStatus default 200]" />
			<http:error-response statusCode="#[vars.httpStatus default 500]" >
				<http:body ><![CDATA[#[payload]]]></http:body>
			</http:error-response>
		</http:listener>
		
		<ee:transform doc:name="Store Original Request">
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="orderRequest" ><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		
		<validation:is-true doc:name="Validate Input" expression="#[vars.orderRequest.customerId != null and vars.orderRequest.productId != null and vars.orderRequest.quantity != null and vars.orderRequest.quantity &gt; 0]" message="Invalid request: customerId, productId, and a positive quantity are required." >
			<error-mapping sourceType="VALIDATION:INVALID_BOOLEAN" targetType="APP:INVALID_INPUT" />
		</validation:is-true>
		
		<http:request method="GET" doc:name="Check Product Availability" config-ref="HTTP_Request_configuration" path="#['/api/mock/products/' ++ vars.orderRequest.productId]">
			<error-mapping sourceType="HTTP:NOT_FOUND" targetType="APP:PRODUCT_NOT_FOUND" />
		</http:request>
		
		<ee:transform doc:name="Store Product Info">
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="productInfo" ><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		
		<choice doc:name="Choice" >
			<when expression="#[vars.productInfo.stock >= vars.orderRequest.quantity]">
				<logger level="INFO" doc:name="Logger" message="Stock is available."/>
			</when>
			<otherwise >
				<raise-error doc:name="Raise error" type="APP:INSUFFICIENT_STOCK" description="Insufficient luxury boutique stock available for the requested product."/>
			</otherwise>
		</choice>
		
		<ee:transform doc:name="Calculate Order Amount and Apply Discount">
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
var subtotal = vars.productInfo.price * vars.orderRequest.quantity
var discount = if (subtotal > 10000) (subtotal * 0.10) else 0
var finalAmount = subtotal - discount
---
{
	"customerId": vars.orderRequest.customerId,
	"productId": vars.orderRequest.productId,
	"productName": vars.productInfo.name,
	"quantity": vars.orderRequest.quantity,
	"subtotal": subtotal,
	"discount": discount,
	"totalAmount": finalAmount,
	"status": "CREATED"
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		
		<http:request method="POST" doc:name="Create Order" config-ref="HTTP_Request_configuration" path="/api/mock/orders" />
		
		<ee:transform doc:name="Store Order Result">
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="orderResult" ><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		
		<ee:transform doc:name="Prepare Notification">
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	"customerId": vars.orderResult.customerId,
	"message": "Your luxury order " ++ vars.orderResult.orderId ++ " (" ++ vars.orderResult.productName ++ ") has been confirmed! Total: ₹" ++ vars.orderResult.totalAmount
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		
		<http:request method="POST" doc:name="Send Notification" config-ref="HTTP_Request_configuration" path="/api/mock/notifications" />
		
		<ee:transform doc:name="Final Response">
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	"success": true,
	"message": "Luxury Fashion Order processed successfully",
	"orderDetails": vars.orderResult
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		
	</flow>
	
	<!-- MOCK FLOWS FOR EXTERNAL APIs -->
	<flow name="mock-product-api-flow" >
		<http:listener doc:name="Listener" config-ref="HTTP_Listener_config" path="/api/mock/products/{productId}" allowedMethods="GET">
			<http:response statusCode="#[vars.httpStatus default 200]" />
			<http:error-response statusCode="#[vars.httpStatus default 500]" />
		</http:listener>
		<choice doc:name="Choice" >
			<when expression="#[attributes.uriParams.productId == 'PROD123']">
				<ee:transform doc:name="Transform Message">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	"productId": "PROD123",
	"name": "Italian Silk Tuxedo",
	"price": 45000,
	"stock": 10
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
			</when>
			<when expression="#[attributes.uriParams.productId == 'PROD789']">
				<ee:transform doc:name="Transform Message">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	"productId": "PROD789",
	"name": "Swiss Chronograph Watch",
	"price": 120000,
	"stock": 5
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
			</when>
			<when expression="#[attributes.uriParams.productId == 'PROD101']">
				<ee:transform doc:name="Transform Message">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	"productId": "PROD101",
	"name": "Designer Leather Handbag",
	"price": 65000,
	"stock": 8
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
			</when>
			<when expression="#[attributes.uriParams.productId == 'PROD456']">
				<ee:transform doc:name="Transform Message">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	"productId": "PROD456",
	"name": "Luxury Leather Belt",
	"price": 800,
	"stock": 2
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
			</when>
			<otherwise >
				<ee:transform doc:name="Transform Message">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	"error": "Product not found"
}]]></ee:set-payload>
					</ee:message>
					<ee:variables >
						<ee:set-variable variableName="httpStatus" ><![CDATA[404]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
			</otherwise>
		</choice>
	</flow>
	
	<flow name="mock-order-api-flow" >
		<http:listener doc:name="Listener" config-ref="HTTP_Listener_config" path="/api/mock/orders" allowedMethods="POST"/>
		<ee:transform doc:name="Transform Message">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload ++ {
	"orderId": "LUX-ORD-" ++ uuid()
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</flow>

	<flow name="mock-notification-api-flow" >
		<http:listener doc:name="Listener" config-ref="HTTP_Listener_config" path="/api/mock/notifications" allowedMethods="POST"/>
		<logger level="INFO" doc:name="Logger" message="Luxury Notification sent: #[payload]"/>
		<ee:transform doc:name="Transform Message">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	"status": "VIP Notification Delivered"
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</flow>

</mule>
